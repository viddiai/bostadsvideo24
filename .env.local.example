# ============================================================
# Bostadsvideo24 — Environment variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Stripe — Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend — Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Where order notifications are emailed
ORDER_NOTIFICATION_EMAIL=info@bostadsvideo24.se

# Cal.com — Your booking link username (e.g. "bostadsvideo24/strategimote")
NEXT_PUBLIC_CALCOM_LINK=bostadsvideo24/strategimote

# Public site URL — used in Stripe redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
